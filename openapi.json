          "private_description": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Private Description"
          },
          "public_summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 20,
            "title": "Public Summary"
          },
          "privacy": {
            "type": "string",
            "enum": [
              "summary",
              "summary_technologies",
              "hidden"
            ],
            "title": "Privacy",
            "default": "summary_technologies"
